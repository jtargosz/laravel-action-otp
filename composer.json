{
    "name": "jtargosz/laravel-action-otp",
    "description": "Confirm any action with a one-time code in Laravel 13: the action runs once, only after the code is verified",
    "keywords": ["laravel", "laravel-13", "otp", "one-time-password", "one-time-code", "verification", "verification-code", "2fa", "magic-link", "sms", "confirmation", "action-otp"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "J. Targosz"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/session": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/translation": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "laravel/ai": "^1.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "suggest": {
        "laravel/ai": "Needed only if you want to expose OTP actions as AI tools"
    },
    "autoload": {
        "psr-4": {
            "Jtargosz\\ActionOtp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jtargosz\\ActionOtp\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixtures/Actions.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jtargosz\\ActionOtp\\ActionOtpServiceProvider"
            ],
            "aliases": {
                "ActionOtp": "Jtargosz\\ActionOtp\\Facades\\ActionOtp"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
